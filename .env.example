# =============================================================================
#  DCI-ERANOVE — variables d'environnement (modele)
#  Copier ce fichier en .env et renseigner les valeurs.
#  Le fichier .env n'est JAMAIS commite.
# =============================================================================

# --- Base de donnees ---------------------------------------------------------
# PostgreSQL 16 nu, aucune extension proprietaire.
DATABASE_URL="postgresql://dci:dci@localhost:5432/dci_dev"

# --- Session applicative (T3.a) ----------------------------------------------
# Generer une valeur aleatoire :  openssl rand -base64 48
SESSION_SECRET=""
SESSION_COOKIE_NAME="dci_session"
SESSION_TTL_HEURES="12"

# --- Stockage des pieces jointes (interface StorageAdapter) ------------------
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./.data/pieces-jointes"
STORAGE_TAILLE_MAX_OCTETS="10485760"   # 10 Mo — HYP-2

# Bascule S3 compatible (stockage interne ERANOVE le moment venu).
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Application -------------------------------------------------------------
APP_FUSEAU="Africa/Abidjan"            # HYP-1 : cloture le 10 a 23h59
APP_EXERCICE_COURANT="2026"

# --- Demonstration -----------------------------------------------------------
# MODE_DEMO=true affiche le bandeau permanent "Donnees fictives"
# et active le selecteur de filiale / role.
MODE_DEMO="true"
GRAINE_DEMO="DCI-ERANOVE-2026"         # graine du generateur deterministe FNV
