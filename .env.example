# =============================================================================
#  DCI-ERANOVE — variables d'environnement (modele)
#  Copier ce fichier en .env et renseigner les valeurs.
#  Le fichier .env n'est JAMAIS commite.
# =============================================================================

# --- Base de donnees ---------------------------------------------------------
# PostgreSQL 16 nu, aucune extension proprietaire.
DATABASE_URL="postgresql://dci:dci@localhost:5432/dci_dev"

# --- Session applicative (T3.a) ----------------------------------------------
# Generer une valeur aleatoire :  openssl rand -base64 48
SESSION_SECRET=""
SESSION_COOKIE_NAME="dci_session"
SESSION_TTL_HEURES="12"

# --- Stockage des pieces jointes (interface StorageAdapter) ------------------
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./.data/pieces-jointes"
STORAGE_TAILLE_MAX_OCTETS="10485760"   # 10 Mo — HYP-2

# Bascule S3 compatible (stockage interne ERANOVE le moment venu).
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Application -------------------------------------------------------------
APP_FUSEAU="Africa/Abidjan"            # HYP-1 : cloture le 10 a 23h59
APP_EXERCICE_COURANT="2026"

# --- Demonstration -----------------------------------------------------------
# MODE_DEMO=true affiche le bandeau permanent "Donnees fictives"
# et active le selecteur de filiale / role.
MODE_DEMO="true"
GRAINE_DEMO="DCI-ERANOVE-2026"         # graine du generateur deterministe FNV

# Date de reference de la demonstration (RG-29 / HYP-1).
#
# La fenetre de saisie depend de l'horloge : le mois M est saisissable du 1er au
# 10 du mois M+1. Le jeu de demonstration a aout 2026 pour periode ouverte, ce
# qui n'est vrai que du 1er au 10 septembre 2026. Sans cette variable, l'ecran
# de saisie devient partout en lecture seule des le 11 septembre 2026.
#
# Valeur reprise de l'en-tete de la maquette V2 : « Date de reference du
# prototype : 4 septembre 2026 -> Aout 2026 ouvert, 6 jours restants. »
#
# N'a d'effet que si MODE_DEMO vaut true. LAISSER VIDE EN PRODUCTION : l'horloge
# reelle est alors utilisee.
DATE_REFERENCE_DEMO="2026-09-04T09:00:00Z"
